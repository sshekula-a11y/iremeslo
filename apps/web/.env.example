# Web se připojuje k databázi iRemeslo bez nastavování proměnných (veřejná adresa a publishable key
# jsou v src/lib/supabase/config.ts). Adresu webu pro odkazy v e-mailech si zjistí sám.
#
# Jen pro lokální vývoj proti jiné databázi (např. vlastní Supabase projekt):
# NEXT_PUBLIC_IREMESLO_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_IREMESLO_SUPABASE_KEY=sb_publishable_xxxxxxxx
#
# Service role / secret key sem NIKDY nepatří.
